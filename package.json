{
  "name": "jalyk",
  "description": "CMS",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "predev": "docker compose up -d --wait",
    "dev": "turbo run dev",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d --wait",
    "format": "prettier --write .",
    "lint": "eslint .",
    "build:packages": "pnpm --filter @jalyk/schema --filter @jalyk/contract --filter @jalyk/ui --filter @jalyk/studio build",
    "version:bump": "pnpm --filter @jalyk/schema --filter @jalyk/contract --filter @jalyk/ui --filter @jalyk/studio exec npm version patch --no-git-tag-version",
    "release": "pnpm run version:bump && pnpm run build:packages && pnpm --filter @jalyk/schema --filter @jalyk/contract --filter @jalyk/ui --filter @jalyk/studio publish --access public --no-git-checks"
  },
  "keywords": [
    "cms"
  ],
  "license": "ISC",
  "author": "piscopancer",
  "packageManager": "pnpm@10.11.1",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "prettier": "^3.8.4",
    "turbo": "^2.10.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0"
  }
}
