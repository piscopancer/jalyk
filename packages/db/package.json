{
  "name": "@jalyk/db",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "author": "piscopancer",
  "license": "ISC",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./states": "./src/states.ts",
    "./schema.sql": "./prisma/schema.sql"
  },
  "scripts": {
    "generate": "prisma generate",
    "postinstall": "prisma generate",
    "migrate": "prisma migrate dev",
    "studio": "prisma studio",
    "push": "prisma db push",
    "ddl": "prisma migrate diff --from-empty --to-schema prisma/schema.prisma --script --output prisma/schema.sql",
    "ddl:push": "pnpm run ddl && node --env-file=../../.env.production scripts/apply-ddl.mjs",
    "ddl:reset": "pnpm run ddl && node --env-file=../../.env.production scripts/reset-supabase.mjs",
    "migrate:local": "node --env-file-if-exists=../../.env --env-file-if-exists=../../.env.development scripts/apply-migration.mjs",
    "migrate:supabase": "node --env-file=../../.env.production scripts/apply-migration-supabase.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "@prisma/client-runtime-utils": "7.8.0",
    "effect": "^3.21.3",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "prisma": "7.8.0"
  }
}
