# Окружение БД выбирается переменной DB_TARGET (по умолчанию `local`).
# DB_TARGET="local"      # локальный Docker-Postgres (тестовые данные)
# DB_TARGET="supabase"   # боевая база Supabase (реальные данные)

# --- local ---------------------------------------------------------------
# По умолчанию используется локальный Postgres из docker-compose.yml (см.
# дефолты в src/config.ts) — для локальной разработки ничего настраивать не нужно.
# DATABASE_URL="postgresql://jalyk:jalyk@localhost:5432/jalyk"
# SEED_DATABASE_URL="postgresql://jalyk:jalyk@localhost:5432/jalyk_seed"

# --- supabase ------------------------------------------------------------
# Нужны при DB_TARGET=supabase. Рантайм — transaction pooler (:6543, pgbouncer),
# миграции/db push — session pooler (:5432). Берутся из Supabase → Connect.
# SUPABASE_DATABASE_URL="postgresql://postgres.<ref>:<пароль>@aws-1-eu-north-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# SUPABASE_DIRECT_URL="postgresql://postgres.<ref>:<пароль>@aws-1-eu-north-1.pooler.supabase.com:5432/postgres"
