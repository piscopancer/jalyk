{
  "include": ["."],
  "exclude": ["node_modules"],
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "target": "esnext",
    "lib": ["esnext", "DOM", "DOM.Iterable"],
    "types": ["react"],
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
