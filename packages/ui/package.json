{
  "name": "@jalyk/ui",
  "version": "0.0.4",
  "type": "module",
  "author": "piscopancer",
  "license": "ISC",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css",
    "./cn": "./src/lib/cn.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./styles.css": "./dist/index.css",
      "./cn": {
        "types": "./dist/cn.d.mts",
        "default": "./dist/cn.mjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown && tailwindcss -i src/styles.css -o dist/index.css --minify",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.18.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.0",
    "react-day-picker": "^10.0.1",
    "shiki": "^4.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.2",
    "@types/react": "^19.2.17",
    "react": "^19.2.7",
    "tsdown": "^0.22.3",
    "typescript": "^6.0.3"
  }
}
