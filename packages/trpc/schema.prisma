datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["queryCompiler", "driverAdapters"]
  moduleFormat    = "esm"
  output          = "./src/prisma"
}

model User {
  // provided by auth provider, must not generate by hand
  id           String       @id
  createdAt    DateTime     @default(now())
  name         String
  photoUrl     String?
  authProvider AuthProvider

  inProjects UserProjectRole[]
}

enum UserRole {
  owner
  editor
  viewer
}

enum AuthProvider {
  google
  github
}

model UserProjectRole {
  userId    String
  projectId String
  role      UserRole

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([userId, projectId])
}

model Project {
  id        String   @id @default(cuid())
  title     String
  createdAt DateTime @default(now())

  documents Document[]
  users     UserProjectRole[]
}

model Field {
  documentId String
  path       String
  value      Json?

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@id([documentId, path])
}

model Document {
  id        String   @id @default(cuid())
  type      String
  createdAt DateTime @default(now())
  fields    Field[]
  projectId String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}
