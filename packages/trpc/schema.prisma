datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "./prisma"
}

model User {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  email     String    @unique
  name      String
  projects  Project[]
}

enum UserRole {
  Owner
  Editor
  Viewer
}

model UserProjectRole {
  userId    String
  projectId String
  role      UserRole

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([userId, projectId])
}

model Project {
  id        String            @id @default(cuid())
  title     String
  createdAt DateTime          @default(now())
  documents Document[]
  users     UserProjectRole[]
}

model Field {
  documentId String
  path       String
  value      Json?

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@id([documentId, path])
}

model Document {
  id        String   @id @default(cuid())
  type      String
  createdAt DateTime @default(now())
  fields    Field[]
  projectId String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}
