# Скопируйте в .env.development. Строки подключения к БД для локальной разработки;
# накладываются поверх общего .env. Какое db-состояние активно (local/many/…),
# решает JALYK_DB_STATE от лаунчера (флаг --db) — ЗДЕСЬ его не задаём, иначе
# --env-file api перезатрёт выбор. DATABASE_URL нужен состоянию local,
# SEED_DATABASE_URL — сид-состояниям и обязателен всегда (резолвится при импорте db).
DATABASE_URL="postgresql://jalyk:jalyk@localhost:5432/jalyk"
SEED_DATABASE_URL="postgresql://jalyk:jalyk@localhost:5432/jalyk_seed"
