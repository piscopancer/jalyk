{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [".env"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "@repo/trpc#db-dev": {},
    "dev": {
      "cache": false,
      "persistent": true,
      "with": ["@repo/trpc#db-dev"]
    }
  }
}
