# Скопируйте в .env и заполните значениями. Один общий файл на apps/web и
# apps/api: web грузит его через vite (loadEnv в vite.config.ts), api — через
# `tsx --env-file-if-exists`.
#
# Переменные подключения к БД сюда НЕ кладём — они вынесены по окружениям в
# .env.development (локальный Docker) и .env.production (Supabase); см. файлы
# .env.development.example и .env.production.example. Нужный файл выбирается тем,
# как запущен процесс: vite по своему mode, api — флагом --env-file в dev/start.

# Секрет better-auth. ОБЯЗАН совпадать у web и api, иначе сессии, выписанные
# сайтом, не пройдут валидацию в API. Сгенерировать: `openssl rand -base64 24`.
BETTER_AUTH_SECRET=""

# Окружение авторизации (по аналогии с DB_TARGET). AUTH_TARGET выбирает связку
# «домен + OAuth-приложения»: local — тестовая реализация на jalyk.local.dev:3000,
# prod — боевой домен платформы. Домен и креды берутся из суффиксных переменных
# _LOCAL / _PROD; менять их нужно ПАРАМИ (домен + client_id/secret того же
# приложения), иначе GitHub вернёт «redirect_uri is not associated».
AUTH_TARGET="local"

# Канонические адреса сайта по окружениям. На них завязаны OAuth-редиректы;
# callback URL в настройках OAuth-приложения должен быть <адрес> + /api/auth/callback/{provider}.
# Для локальной разработки используется стабильный домен jalyk.local.dev (запись в
# hosts указывает его на текущий LAN-IP), чтобы Google OAuth принял адрес (он
# требует доменное имя + https и не принимает голый IP), а настройки OAuth не
# приходилось менять при смене IP. См. блок HTTPS ниже.
BETTER_AUTH_URL_LOCAL="https://jalyk.local.dev:3000"
BETTER_AUTH_URL_PROD=""

# Локальный TLS (mkcert): пути к сертификату и ключу относительно корня монорепы.
# Когда заданы — dev-серверы web/api/test-client поднимаются по https. Сгенерировать:
#   mkcert -install
#   mkcert -cert-file certs/jalyk.local.dev.pem -key-file certs/jalyk.local.dev-key.pem jalyk.local.dev localhost 127.0.0.1
# В hosts добавить строку: <твой-LAN-IP>  jalyk.local.dev
HTTPS_CERT_FILE="certs/jalyk.local.dev.pem"
HTTPS_KEY_FILE="certs/jalyk.local.dev-key.pem"

# OAuth-приложения по окружениям (_LOCAL / _PROD выбираются AUTH_TARGET).
# GitHub: Settings → Developer settings → OAuth Apps.
# Google: Google Cloud Console → Credentials → OAuth 2.0 Client IDs.
GITHUB_CLIENT_ID_LOCAL=""
GITHUB_CLIENT_SECRET_LOCAL=""
GITHUB_CLIENT_ID_PROD=""
GITHUB_CLIENT_SECRET_PROD=""
GOOGLE_CLIENT_ID_LOCAL=""
GOOGLE_CLIENT_SECRET_LOCAL=""
GOOGLE_CLIENT_ID_PROD=""
GOOGLE_CLIENT_SECRET_PROD=""

# Хранилище ассетов. local — файлы в папке uploads (дев), s3 — S3-совместимое
# (Supabase Storage / R2 / Yandex). При s3 обязательны переменные ниже.
JALYK_STORAGE="local"
# Supabase Storage → Connect / S3 connection: endpoint вида
# https://<ref>.supabase.co/storage/v1/s3, region из той же панели, ключи из
# Storage → S3 Access Keys. Bucket создаётся отдельно (приватный).
JALYK_S3_ENDPOINT=""
JALYK_S3_REGION="eu-north-1"
JALYK_S3_BUCKET=""
JALYK_S3_ACCESS_KEY_ID=""
JALYK_S3_SECRET_ACCESS_KEY=""

# Песочница студии (apps/test-client). projectId и api-ключ (scope write) из
# админки платформы; VITE_JALYK_API_URL по умолчанию http://localhost:3001.
# Редактор входит прямо в студии: кнопка уводит на центральный домен Jalyk
# (VITE_JALYK_AUTH_URL, по умолчанию web на :3000), оттуда возвращается токен.
# ВАЖНО: origin песочницы (http://localhost:3002) должен быть в списке доверенных
# origin'ов проекта (project.allowedOrigins), иначе вход откажет возвращать токен.
VITE_JALYK_PROJECT_ID=""
VITE_JALYK_API_KEY=""
VITE_JALYK_API_URL="https://jalyk.local.dev:3001"
VITE_JALYK_AUTH_URL="https://jalyk.local.dev:3000"
