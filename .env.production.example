# Скопируйте в .env.production. Переменные БД для production (Supabase);
# накладываются поверх общего .env. Выбирается процессом в режиме production
# (vite build по mode, api — флагом --env-file в start-скрипте). На Railway этот
# файл не нужен — те же переменные задаются в дашборде сервиса.
# Строки берутся из Supabase → Connect: transaction pooler (:6543) для рантайма,
# session pooler (:5432) для миграций/DDL.
DB_TARGET="supabase"
SUPABASE_DATABASE_URL="postgresql://postgres.<ref>:<password>@<host>.pooler.supabase.com:6543/postgres?pgbouncer=true"
SUPABASE_DIRECT_URL="postgresql://postgres.<ref>:<password>@<host>.pooler.supabase.com:5432/postgres"
